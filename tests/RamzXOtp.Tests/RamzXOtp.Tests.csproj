<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup>
    <TestKeePassDir>$(MSBuildThisFileDirectory)..\..\testenv\KeePass\</TestKeePassDir>
    <KeePassDir Condition="'$(KeePassDir)' == ''">$(TestKeePassDir)</KeePassDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RamzXOtp\RamzXOtp.csproj" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="KeePass">
      <HintPath>$(KeePassDir)KeePass.exe</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

</Project>
